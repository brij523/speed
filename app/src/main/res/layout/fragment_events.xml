<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragment.EventsFragment">

    <TextView
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:id="@+id/recently_added_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:textAppearance="@style/text_14sdp_bold_black"
        android:text="@string/recently_added"
        />
    <TextView
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_below="@id/recently_added_label"
        android:textAppearance="@style/text_10sdp_black"
        android:text="20-09-2019"
        />
    
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_120sdp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_20sdp"
        app:cardElevation="@dimen/_10sdp"
        android:layout_height="@dimen/_30sdp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/icon_label"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@mipmap/account"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_5sdp"
                />
             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_centerVertical="true"
                 android:layout_toRightOf="@id/icon_label"
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_marginLeft="@dimen/_10sdp"
                 android:textAppearance="@style/text_12sdp_blue"
                 android:text="@string/my_result"

                 />

        </RelativeLayout>


    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_below="@id/date"
        android:layout_marginTop="@dimen/_20sdp"
        android:id="@+id/eventsRecycle"
        android:fadeScrollbars="false"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/_50sdp"
        android:layout_height="match_parent"/>


</RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</layout>