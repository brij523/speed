<?xml version="1.0" encoding="utf-8"?>
<layout>
    <androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.MyCoachFragment">

    <TextView
        android:id="@+id/recommend_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/text_14sdp_bold_black"
        android:text="@string/recommend"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        />
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRecommend"
        android:layout_below="@id/recommend_label"
        android:layout_marginLeft="@dimen/_20sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_width="match_parent"
        app:cardCornerRadius="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_height="@dimen/_150sdp">
        <RelativeLayout
            android:background="@drawable/sample_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleSwimmingStyle"
        android:layout_below="@id/cardRecommend"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:fadeScrollbars="true"
        android:layout_marginBottom="@dimen/_50sdp"
        android:layout_height="match_parent"/>

</RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</layout>